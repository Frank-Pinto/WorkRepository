# Start the total at zero and make an empty list for the items.
total = 0
rows = []

# Keep asking for items until the user enters q.
while True:
    quantity_text = input("Enter quantity (or q to finish): ")
    if quantity_text.lower() == "q":
        break

    # Get the quantity and price as numbers.
    quantity = float(quantity_text)
    price = float(input("Enter price: "))

    # Give a 10% discount when quantity times price is over 10,000.
    disc = 0.9 if price * quantity > 10000 else 1

    # Calculate this item's extended price and show the calculation.
    extprice = quantity * price * disc
    process = f"{quantity:g} x {price:,.2f} x {disc:g}"

    # Add this item's price to the total and save its details for the table.
    total += extprice
    rows.append((quantity, price, process, extprice))

# Print the table heading and each saved item.
print(f"{'Input':<24} {'Process':<32} Output")
for quantity, price, process, extprice in rows:
    print(f"Q={quantity:g}, P={price:,.2f}   {process:<32} ExtPrice={extprice:,.2f}")

# Print the total for all items.
print(f"Total extended price: {total:,.2f}")


