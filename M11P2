# Calculate and return the total points and average exam score.
def calculate_exam_data(exam1, exam2, exam3):
    # Add the three exam scores to get the total.
    total_points = exam1 + exam2 + exam3
    # Divide the total by three to find the average.
    average_score = total_points / 3
    return total_points, average_score

def main():
    # Get the student's name and three exam scores.
    last_name = input("Enter the student's last name: ")
    exam1 = float(input("Enter the score for Exam 1: "))
    exam2 = float(input("Enter the score for Exam 2: "))
    exam3 = float(input("Enter the score for Exam 3: "))

    # Get both calculated values from the function.
    total_points, average_score = calculate_exam_data(exam1, exam2, exam3)

    # Display the student's name, total points, and average score.
    print(f"Student Name: {last_name}")
    print(f"Total Points: {total_points:.2f}")
    print(f"Average Score: {average_score:.2f}")

# Run main() when this file is started as a program.
if __name__ == "__main__":
    main()