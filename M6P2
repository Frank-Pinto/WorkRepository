"""
-------
Inputs:
Part #
Quantity
Process:
If Part # = 10 or 55 unit price =1
If Part # =  99 unit price = 2
If part # = 80 or 70 unit price = 3
Else unit price = 5
Total = quantity * unit price
Output:
Total
-------
"""

#1. Input
part_number = int(input("Enter part number: "))
quantity = int(input("Enter quantity: "))

#2. Process
if part_number == 10 or part_number == 55:
    unit_price = 1
elif part_number == 99:
    unit_price = 2
elif part_number == 80 or part_number == 70:
    unit_price = 3
else:
    unit_price = 5

total = quantity * unit_price

#3. Output
print(f"Total: ${total:.2f}")
