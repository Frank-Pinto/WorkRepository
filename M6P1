"""
Input:
    Quantity of widgets
Process:
    If quantity > 10,000, unit price = $10
    If quantity is from 5,000 to 10,000, unit price = $20
    If quantity < 5,000, unit price = $30
    Extended price = quantity * unit price
    Tax = extended price * 0.07
    Total = extended price + tax
Output:
    Extended price
    Tax amount
    Total
"""

#1. Input
quantity = int(input("Enter quantity of widgets: "))

#2. Process
if quantity > 10000:
    unit_price = 10
elif quantity >= 5000:
    unit_price = 20
else:
    unit_price = 30

extended_price = quantity * unit_price
tax = extended_price * 0.07
total = extended_price + tax

#3. Output
print(f"Extended price: ${extended_price:.2f}")
print(f"Tax: ${tax:.2f}")
print(f"Total: ${total:.2f}")